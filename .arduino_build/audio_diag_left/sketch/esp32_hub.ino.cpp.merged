#include <Arduino.h>
#line 1 "C:\\Users\\Wits student\\Desktop\\eLingo Hub\\elingohubMVP\\firmware\\esp32_hub\\esp32_hub.ino"
#include "api_manager.h"
#include "audio_manager.h"
#include "button_manager.h"
#include "config.h"
#include "lcd_manager.h"
#include "led_manager.h"
#include "pins.h"
#include "session_manager.h"
#include "state_machine.h"
#include "wifi_manager.h"

#if !defined(ELINGO_AUDIO_DIAGNOSTIC)
#define ELINGO_AUDIO_DIAGNOSTIC 0
#endif

LedManager ledManager;
LcdManager lcdManager;
ButtonManager buttonManager;
WifiManager wifiManager;
ApiManager apiManager;
SessionManager sessionManager;
AudioManager audioManager;

StateMachine stateMachine(
    wifiManager,
    apiManager,
    lcdManager,
    ledManager,
    buttonManager,
    audioManager,
    sessionManager);

#if ELINGO_AUDIO_DIAGNOSTIC

namespace {

constexpr uint32_t SERIAL_WAIT_MS = 5000;
constexpr uint8_t CAPTURE_COUNTDOWN_SECONDS = 8;
constexpr size_t BASE64_INPUT_BYTES_PER_LINE = 48;

bool diagnosticDone = false;

void printBase64Line(const uint8_t *data, size_t length) {
  static const char alphabet[] =
      "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
  char line[((BASE64_INPUT_BYTES_PER_LINE + 2) / 3) * 4 + 1];
  size_t out = 0;

  for (size_t i = 0; i < length; i += 3) {
    uint32_t b0 = data[i];
    uint32_t b1 = (i + 1 < length) ? data[i + 1] : 0;
    uint32_t b2 = (i + 2 < length) ? data[i + 2] : 0;
    uint32_t triple = (b0 << 16) | (b1 << 8) | b2;

    line[out++] = alphabet[(triple >> 18) & 0x3F];
    line[out++] = alphabet[(triple >> 12) & 0x3F];
    line[out++] = (i + 1 < length) ? alphabet[(triple >> 6) & 0x3F] : '=';
    line[out++] = (i + 2 < length) ? alphabet[triple & 0x3F] : '=';
  }

  line[out] = '\0';
  Serial.println(line);
}

void printBase64Wav(const uint8_t *data, size_t length) {
  Serial.println("[AudioDiag] WAV_BASE64_BEGIN");
  for (size_t offset = 0; offset < length; offset += BASE64_INPUT_BYTES_PER_LINE) {
    size_t lineBytes = min(BASE64_INPUT_BYTES_PER_LINE, length - offset);
    printBase64Line(data + offset, lineBytes);
  }
  Serial.println("[AudioDiag] WAV_BASE64_END");
}

void printDiagnosticHeader() {
  Serial.println();
  Serial.println("[AudioDiag] eLingo Hub INMP441 diagnostic");
  Serial.print("[AudioDiag] Pins SCK=");
  Serial.print(Pins::I2S_SCK);
  Serial.print(" WS=");
  Serial.print(Pins::I2S_WS);
  Serial.print(" SD=");
  Serial.println(Pins::I2S_SD);
  Serial.print("[AudioDiag] Sample rate=");
  Serial.print(Config::AUDIO_SAMPLE_RATE);
  Serial.print(" Hz, chunk=");
  Serial.print(Config::AUDIO_CHUNK_MS);
  Serial.println(" ms");
  Serial.print("[AudioDiag] Free heap=");
  Serial.println(ESP.getFreeHeap());
  Serial.print("[AudioDiag] PSRAM found=");
  Serial.println(psramFound() ? "yes" : "no");
  Serial.print("[AudioDiag] PSRAM size=");
  Serial.println(ESP.getPsramSize());
}

void waitBeforeCapture() {
  Serial.println("[AudioDiag] Put speech near the microphone now.");
  for (int second = CAPTURE_COUNTDOWN_SECONDS; second > 0; --second) {
    Serial.print("[AudioDiag] Recording starts in ");
    Serial.println(second);
    delay(1000);
  }
}

}  // namespace

#endif

void setup() {
  Serial.begin(115200);
#if ELINGO_AUDIO_DIAGNOSTIC
  uint32_t serialStartMs = millis();
  while (!Serial && millis() - serialStartMs < SERIAL_WAIT_MS) {
    delay(10);
  }
#endif
  Serial.println();
  Serial.println("eLingo Hub firmware starting");

#if ELINGO_AUDIO_DIAGNOSTIC
  printDiagnosticHeader();
  if (!audioManager.begin()) {
    Serial.print("[AudioDiag] Audio init failed: ");
    Serial.println(audioManager.lastError());
    diagnosticDone = true;
    return;
  }

  waitBeforeCapture();
  if (!audioManager.start()) {
    Serial.print("[AudioDiag] Audio start failed: ");
    Serial.println(audioManager.lastError());
    diagnosticDone = true;
    return;
  }
#else
  stateMachine.begin();
#endif
}

void loop() {
#if ELINGO_AUDIO_DIAGNOSTIC
  if (diagnosticDone) {
    delay(1000);
    return;
  }

  if (audioManager.update()) {
    AudioChunk chunk = audioManager.takeChunk();
    Serial.print("[AudioDiag] Captured WAV bytes=");
    Serial.println(chunk.length);
    if (chunk.valid()) {
      printBase64Wav(chunk.data, chunk.length);
      audioManager.releaseChunk(chunk);
    } else {
      Serial.println("[AudioDiag] No valid WAV chunk returned");
    }
    Serial.println("[AudioDiag] Diagnostic complete");
    Serial.flush();
    diagnosticDone = true;
  }
#else
  stateMachine.update();
#endif
}

